# Any stable string, at least 16 characters. Set once and leave alone: changing
# it rewrites a new version of every container. Not a secret in its own right,
# but it lives beside the values, so it is not committed either.
secrets_salt = "REPLACE-WITH-ANY-STABLE-STRING"

secrets = {
  "shared-llm-api-key" = "sk-REPLACE-ME"
  "demo-gh-token"      = "ghp_REPLACE-ME"
}
