[Unit]
Description=k3s-gce: self-assemble k3s on first boot
Documentation=https://github.com/apnex/k3s-gce
After=network-online.target k3s-gce-env.service
Wants=network-online.target
# Run-once guard. systemd skips the unit entirely once the marker exists, which
# replaces the marker check the monolithic script did by hand.
ConditionPathExists=!/root/k3s-gce/bootstrapped

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/k3s-gce/k3s.sh
# A hung bring-up previously held the flock indefinitely and blocked every
# later run. systemd kills it instead, and the marker stays unwritten so the
# next boot retries.
TimeoutStartSec=1800

# Deliberately no [Install] section -- see k3s-gce-env.service.
